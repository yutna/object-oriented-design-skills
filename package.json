{
  "name": "object-oriented-design-skills",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Yutthana Siphuengchai",
  "description": "Agent Skills carrying design rules for codebases written in an object-oriented style. For Claude Code.",
  "homepage": "https://github.com/yutna/object-oriented-design-skills",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yutna/object-oriented-design-skills.git"
  },
  "bugs": {
    "url": "https://github.com/yutna/object-oriented-design-skills/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "object-oriented-design",
    "software-design",
    "domain-driven-design",
    "agent-skills",
    "claude-code",
    "refactoring"
  ],
  "scripts": {
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#OOP_SOURCES.md\" \"#PRIVATE-NOTES.md\" \"#.claude\"",
    "test": "npm run lint:md && npm run validate:oop && npm run validate:skills && npm run validate:rules && npm run validate:prose && npm run validate:patterns && npm run validate:counts && npm run eval:routing",
    "test:unit": "node --test \"test/**/*.test.mjs\"",
    "test:negative": "node scripts/negative-test.mjs",
    "validate:oop": "node scripts/validate-oop.mjs",
    "validate:skills": "node scripts/validate-skills.mjs",
    "validate:rules": "node scripts/validate-rules.mjs",
    "validate:prose": "node scripts/validate-prose.mjs",
    "validate:patterns": "node scripts/validate-patterns.mjs",
    "validate:counts": "node scripts/validate-counts.mjs",
    "eval:routing": "node scripts/eval-routing.mjs",
    "bump-version": "node scripts/bump-version.mjs",
    "gate": "npm test && npm run test:unit && npm run test:negative"
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "markdownlint-cli2": "0.24.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "re2js": "2.8.8"
  }
}
